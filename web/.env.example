# Server-only backend origin. It is read only by Next.js server code.
# Never add a NEXT_PUBLIC_ alias: browser bundles do not need the API origin.
OPS_API_URL=http://127.0.0.1:8000
# Must exactly match the random >=32-character value in the API's local .env.
OPS_INTERNAL_API_TOKEN=

# Server-only demo banner toggle. Read only by the Next.js server layout and
# passed to client components as a plain boolean prop. Never add a NEXT_PUBLIC_
# alias: the raw flag must not be inlined into browser bundles.
OPS_DEMO_MODE=false

# Operator login. All four values are required; the session secret must be at
# least 32 characters and the independent TOTP secret must be Base32 with at
# least 16 characters. These values are server-only and must never use a
# NEXT_PUBLIC_ prefix.
OPS_AUTH_USERNAME=operator
OPS_AUTH_PASSWORD=replace-with-a-long-unique-password # pragma: allowlist secret
OPS_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
OPS_AUTH_TOTP_SECRET=replace-with-base32-totp-secret

# Long browser actions run synchronously through the private API. Keep this
# above the API/browser-worker timeout. Allowed range: 30000–600000 ms.
OPS_RUN_ACTION_TIMEOUT_MS=330000
