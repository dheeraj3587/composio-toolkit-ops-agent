# syntax=docker/dockerfile:1

# Docker Hub official-image index digest for python:3.11.15-slim-bookworm,
# reviewed 2026-07-29. Keep the human-readable tag for update tooling, while
# the digest makes a reviewed build reproducible.
FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

ARG APP_REVISION=local-uncommitted
LABEL org.opencontainers.image.revision=$APP_REVISION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    LANGGRAPH_STRICT_MSGPACK=true \
    ALLOW_LIVE_BROWSER=false \
    ALLOW_LIVE_VENDOR_EMAIL=false \
    OPS_ENABLE_API_DOCS=false \
    RUN_LIVE_TESTS=0 \
    OPS_DB_PATH=/private/ops.db \
    CHECKPOINT_DB_PATH=/private/checkpoints.db \
    SECRET_VAULT_DB_PATH=/private/secret_vault.db \
    PROVIDER_EFFECTS_DB_PATH=/private/provider_effects.db

RUN addgroup --system ops && adduser --system --ingroup ops --home /app ops

WORKDIR /app

COPY requirements-api.txt requirements-providers.txt requirements-runtime.lock ./
# The API imports the encrypted vault at startup and can wire configured
# provider adapters at runtime. Install both the core and provider lock files in
# the production image so health checks and the selected browser provider never
# depend on a developer-machine virtual environment.
#
# NOTE: no Chromium binary is installed here, deliberately. The Python package
# alone cannot launch a browser, which is why BROWSER_PROVIDER=playwright must
# point at the separate browser service (see Dockerfile.browser and
# compose.prod.yaml). Running a browser inside the control-plane container
# would let a crash or memory spike take down the API.
RUN python -m pip install --no-cache-dir --no-build-isolation --require-hashes \
    --requirement requirements-runtime.lock \
    && python -m pip uninstall --yes setuptools wheel

COPY --chown=root:root api ./api
COPY --chown=root:root ops ./ops
COPY --chown=root:root browser_service ./browser_service
COPY --chown=root:root data/p1 ./data/p1

RUN find /app/api /app/ops /app/browser_service /app/data/p1 -type d -exec chmod 0555 {} + \
    && find /app/api /app/ops /app/browser_service /app/data/p1 -type f -exec chmod 0444 {} + \
    && install -d -o ops -g ops -m 0700 /private /data /vault

USER ops
# /private preserves the development default; /data is the production mount;
# /vault is API-owned credential storage. The browser service has neither this
# mount nor its encryption key; it can consume one run-scoped transient value or
# write one reviewed capture only through the narrow authenticated broker. All
# directories are pre-created as ops:0700 so a first-run named volume inherits
# safe ownership under the non-root, read-only container.
VOLUME ["/private", "/data", "/vault"]
EXPOSE 8000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import json, os, sys, urllib.request; token=os.environ.get('OPS_INTERNAL_API_TOKEN') or ''; request=urllib.request.Request('http://127.0.0.1:8000/api/system/health', headers={'X-Ops-Internal-Token': token}); payload=json.load(urllib.request.urlopen(request, timeout=3)); sys.exit(0 if payload.get('status') == 'healthy' else 1)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "25", "--no-access-log"]
