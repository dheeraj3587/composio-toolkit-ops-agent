# syntax=docker/dockerfile:1
#
# Browser worker image: Chromium + Playwright, deliberately SEPARATE from the API.
#
# The hardened API image (Dockerfile.api) intentionally does NOT contain Chromium:
# installing the `playwright` Python package does not install a browser binary, and
# putting a browser inside the control-plane container means a Chromium crash or
# memory spike can take down the API. Keeping them separate is the whole point.
#
# Build:  docker build -f Dockerfile.browser -t composio-ops-browser .
# Compose (see compose.prod.yaml notes) should run this with:
#   init: true          # reap zombie Chromium children
#   shm_size: 2gb       # default for two isolated headed sessions
#   pids_limit: 768
#
# This image is the only browser execution path in the production stack, so
# Chromium availability is a build-time fact rather than a runtime surprise.
#
# It now runs the browser SERVICE (browser_service.main:app) rather than a one-shot
# probe, so Chromium's lifetime is decoupled from the API's: restarting the API no
# longer kills a live browser session.

# Docker Hub official-image index digest for python:3.11.15-slim-bookworm,
# reviewed 2026-07-29. Chromium itself remains pinned by requirements-providers
# and is installed during the build from that exact Playwright package.
FROM python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

ARG APP_REVISION=local-uncommitted
LABEL org.opencontainers.image.revision=$APP_REVISION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    BROWSER_PROVIDER=playwright \
    ALLOW_LIVE_BROWSER=false \
    BROWSER_SERVICE_PORT=8081 \
    BROWSER_OPERATION_TIMEOUT_SECONDS=300 \
    PLAYWRIGHT_MAX_SESSIONS=2 \
    BROWSER_INTERACTIVE_HITL_ENABLED=false \
    BROWSER_VNC_PORT=5900 \
    BROWSER_DISPLAY_NUM=99

RUN addgroup --system ops && adduser --system --ingroup ops --home /app ops

WORKDIR /app

COPY requirements-api.txt requirements-providers.txt requirements-runtime.lock ./
RUN python -m pip install --no-cache-dir --no-build-isolation --require-hashes \
    --requirement requirements-runtime.lock \
    && python -m pip uninstall --yes setuptools wheel

# Install the Chromium binary AND its OS dependencies. `pip install playwright`
# alone does not do this — omitting it is why a Playwright launch fails inside a
# plain Python image.
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rx /ms-playwright

# Interactive-HITL display stack. A screenshot cannot solve a CAPTCHA, an account
# chooser or an MFA prompt, so real remote control has to be possible — but it is
# started only when BROWSER_INTERACTIVE_HITL_ENABLED is true (see the entrypoint),
# and x11vnc binds to container loopback so there is no raw public VNC port.
#
# `novnc` provides the browser-side client assets; websockify is deliberately NOT
# used as the gateway: its auth plugins receive only headers and its token plugin
# logs unknown tokens verbatim, so it cannot enforce a signed session-bound grant
# without leaking it. The authenticated relay lives in browser_service/novnc.py.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        xvfb \
        x11vnc \
        fluxbox \
        novnc \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=root:root api ./api
COPY --chown=root:root ops ./ops
COPY --chown=root:root browser_service ./browser_service
COPY --chown=root:root data/p1 ./data/p1
COPY --chown=root:root docker/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh

# /browser-data holds profiles + encrypted storage state. The credential vault
# intentionally does not exist in this image; browser secrets cross only the
# authenticated, narrowly scoped API broker boundary.
RUN find /app/api /app/ops /app/browser_service /app/data/p1 -type d -exec chmod 0555 {} + \
    && find /app/api /app/ops /app/browser_service /app/data/p1 -type f -exec chmod 0444 {} + \
    && chmod 0555 /usr/local/bin/browser-entrypoint.sh \
    && install -d -o ops -g ops -m 0700 /browser-data \
    && install -d -o ops -g ops -m 0700 /browser-data/storage-state \
    && install -d -m 1777 /tmp/.X11-unix

# Non-root: Chromium's own sandbox stays ENABLED by default. Set
# PLAYWRIGHT_DISABLE_SANDBOX=true only where the host cannot support it.
USER ops

EXPOSE 8081

# Readiness: the SERVICE's own provider-aware health endpoint, which reports
# whether Chromium can actually launch (a Python import check would not catch a
# missing binary or a broken sandbox).
HEALTHCHECK --interval=60s --timeout=40s --start-period=45s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys,json; r=json.load(urllib.request.urlopen('http://127.0.0.1:8081/internal/ready', timeout=30)); sys.exit(0 if r.get('state') in ('ready','capacity_exhausted') and r.get('chromium_installed') and r.get('context_launch_ok') and r.get('janitor_running') else 1)"]

# The entrypoint conditionally starts Xvfb/fluxbox/x11vnc, then execs this CMD.
ENTRYPOINT ["/usr/local/bin/browser-entrypoint.sh"]
# The interactive grant is necessarily carried in the WebSocket query string.
# Disable HTTP access logs here; browser_service.main separately filters the
# uvicorn.error WebSocket handshake records that also include the query string.
# Application logs emit only sanitized session/reason fields.
CMD ["uvicorn", "browser_service.main:app", "--host", "0.0.0.0", "--port", "8081", "--timeout-graceful-shutdown", "25", "--no-access-log"]
