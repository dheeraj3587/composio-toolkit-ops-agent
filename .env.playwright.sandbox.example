# Playwright SANDBOX environment example — evaluation only.
#
# Copy to .env.playwright.sandbox and adjust. This file must never contain a real
# provider secret, and this configuration must never be pointed at a production or
# untrusted vendor account.
#
# Production is unaffected: compose.prod.yaml does not read this file and keeps
# BROWSER_PROVIDER unset (i.e. browser_use).

# Select the self-hosted harness inside the sandbox container.
BROWSER_PROVIDER=playwright

# Live browsing stays OFF by default. Turn it on only for a deliberate, supervised
# sandbox run against a disposable test account.
ALLOW_LIVE_BROWSER=false

# Concurrency cap. Each session is a real Chromium process; 2 suits a small VPS.
PLAYWRIGHT_MAX_SESSIONS=2

# Chromium's own sandbox stays ENABLED by default. Set true only on a host that
# cannot provide the required user namespaces / seccomp profile.
PLAYWRIGHT_DISABLE_SANDBOX=false

# Optional free-tier inference for the bounded action brain. Leave blank to run the
# harness deterministically (trace-only); with no key the loop stops honestly at an
# ambiguous step instead of guessing.
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENAI_API_KEY=

# Model overrides (defaults already target strict-JSON-capable gpt-oss models).
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
