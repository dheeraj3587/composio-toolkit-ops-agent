# Assignment environment template (Playwright browser service + You.com research).
#
#   cp .env.assignment.example .env.assignment
#   docker compose -f compose.prod.yaml -f compose.assignment.yaml \
#     --env-file .env.assignment up -d --build
#
# WARNINGS
#   - NEVER commit .env.assignment. Only this .example template is tracked.
#   - Placeholders only. Replace every "replace-with-..." value before starting.
#   - Generate each encryption key INDEPENDENTLY; never reuse one for two roles.
#   - Keep SECRET_VAULT_KEY and LANGGRAPH_AES_KEY stable across restarts, or
#     previously stored secrets and checkpoints become unreadable.
#   - This stack is for evaluation. It is NOT certified for production.
#
# Key generation (same commands the deployment guide uses):
#   random tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   AES key:       python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Fernet key:    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Shared internal API token (API + web) ─────────────────────────────────────
OPS_INTERNAL_API_TOKEN=replace-with-random-token

# ── Encryption keys ──────────────────────────────────────────────────────────
LANGGRAPH_AES_KEY=replace-with-valid-aes-key
SECRET_VAULT_KEY=replace-with-valid-fernet-key

# ── Browser provider: self-hosted Playwright service ─────────────────────────
BROWSER_PROVIDER=playwright
ALLOW_LIVE_BROWSER=true

# The API reaches the service on the private network only; 8081 is never
# published to the host. With no token the service refuses every request.
BROWSER_SERVICE_URL=http://browser-worker:8081
BROWSER_SERVICE_TOKEN=replace-with-random-token
BROWSER_SERVICE_OWNER=assignment-owner

# Interactive mode owns one X display, so service capacity must remain exactly 1.
PLAYWRIGHT_MAX_SESSIONS=1
# Chromium's own sandbox is disabled only because most container hosts cannot
# support it; the service still runs non-root with no privilege escalation.
PLAYWRIGHT_DISABLE_SANDBOX=true
# Chromium must NOT run inside the API container.
PLAYWRIGHT_IN_PROCESS_SANDBOX=false
# Headed Chromium streams through the signed same-origin relay. x11vnc itself
# remains loopback-only and neither port 5900 nor 8081 is published.
BROWSER_INTERACTIVE_HITL_ENABLED=true
BROWSER_DISPLAY_NUM=99
BROWSER_SCREEN_GEOMETRY=1440x900x24
BROWSER_VNC_PORT=5900
BROWSER_LIVE_VIEW_TOKEN_SECONDS=300

# The VPS is genuinely in Singapore; use its real locale/timezone rather than
# spoofing a different location.
TZ=Asia/Singapore
LANG=C.UTF-8

# Encrypts persisted login storage state at rest. Blank = not persisted.
BROWSER_STORAGE_STATE_KEY=replace-with-valid-fernet-key

# ── Research providers ───────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY=replace-with-gemini-key

# You.com is retrieval only: it never drives a browser and never sees a
# credential. Search and Contents are on; the expensive Research fallback is off.
YDC_API_KEY=replace-with-you-key
YOU_SEARCH_ENABLED=true
YOU_CONTENTS_ENABLED=true
YOU_RESEARCH_ENABLED=false

# Optional fallback discovery provider; blank disables it.
PERPLEXITY_API_KEY=

# ── Outbound email stays disabled ────────────────────────────────────────────
ALLOW_LIVE_VENDOR_EMAIL=false

# ── Reverse proxy (required by compose.prod.yaml) ────────────────────────────
DOMAIN=your-domain.example
ACME_EMAIL=
OPS_BASIC_AUTH_USER=ops-admin
# Generate with: caddy hash-password
OPS_BASIC_AUTH_HASH=replace-with-caddy-bcrypt-hash
