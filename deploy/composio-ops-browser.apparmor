# Composio Ops browser-worker AppArmor profile.
#
# Based on github.com/moby/profiles/apparmor/template.go (Docker's current
# docker-default profile), reviewed 2026-07-29. The one intentional capability
# addition is `userns,`: Chromium needs an unprivileged user namespace for its
# primary Linux sandbox, while Ubuntu 24.04 otherwise denies it to unrecognised
# binaries. The container still runs non-root with every Linux capability
# dropped, no-new-privileges, a read-only root filesystem, and the separately
# pinned Chromium seccomp allowlist.

abi <abi/4.0>,
#include <tunables/global>

profile composio-ops-browser-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  userns,

  network,
  network unix,
  # Disallow AF_ALG (Linux kernel crypto API).
  deny network alg,

  capability,
  file,
  umount,

  # Host/runtime processes may stop or kill the container.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,

  # Container processes may signal one another.
  signal (send,receive) peer=composio-ops-browser-v1,

  # Preserve Docker's default procfs/sysfs write restrictions.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Match Docker's same-profile ptrace boundary. Docker's dropped CAP_SYS_PTRACE,
  # no-new-privileges and seccomp rules remain additional independent controls.
  ptrace (trace,tracedby,read,readby) peer=composio-ops-browser-v1,
}
