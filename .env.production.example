# Production environment template for the single-Droplet deployment.
#
# Copy this file to .env.production and fill in the blank values:
#     cp .env.production.example .env.production
#
# WARNINGS
#   - NEVER commit .env.production. Only this .example template is tracked.
#   - NEVER put provider keys in NEXT_PUBLIC_ variables. Nothing here is exposed
#     to the browser; the frontend reads OPS_API_URL only in server code.
#   - Generate each encryption key INDEPENDENTLY with a cryptographically secure
#     generator (see docs/OPERATIONS.md). Do not reuse one key for both.
#   - Retain the SAME SECRET_VAULT_KEY (and LANGGRAPH_AES_KEY) across every
#     redeployment. If the vault key changes, previously stored secrets and
#     checkpoints become permanently unreadable.

# ── Reverse proxy / TLS ───────────────────────────────────────────────────────
# Public hostname whose DNS A record points at the Droplet. Caddy issues HTTPS
# for this name automatically. For an IP-only development fallback use ":80"
# (plain HTTP, no certificate) — see deploy/Caddyfile.
DOMAIN=your-domain.example
# Optional: email used only for certificate expiry notices.
ACME_EMAIL=
# Basic Auth protects every public route except /healthz. Generate a Caddy
# bcrypt hash with: caddy hash-password
OPS_BASIC_AUTH_USER=ops-admin
OPS_BASIC_AUTH_HASH=replace-with-caddy-bcrypt-hash
# Used only by deploy-droplet.sh for an authenticated public-edge smoke check.
# It is never passed into a container. Rotate it with the Caddy hash.
OPS_BASIC_AUTH_PASSWORD=

# ── Frontend (server-only) ────────────────────────────────────────────────────
# Internal address of the API on the private Docker network. Read only by
# Next.js server code. Do not point this at a public URL.
OPS_API_URL=http://api:8000
# Shared internal API token. This is passed only to the API and web containers;
# it must never be exposed as NEXT_PUBLIC_*.
OPS_INTERNAL_API_TOKEN=replace-with-random-internal-token
# Server-only demo banner toggle.
OPS_DEMO_MODE=false

# ── API: cross-origin + docs ──────────────────────────────────────────────────
# Browser origin(s) allowed to call the API directly. In this topology the
# browser talks to Next.js, not the API, so this should just match your site.
OPS_CORS_ORIGINS=https://your-domain.example
# Keep API docs disabled in production.
OPS_ENABLE_API_DOCS=false

# ── API: persistent database paths (under the /data volume) ───────────────────
OPS_DB_PATH=/data/ops.db
CHECKPOINT_DB_PATH=/data/checkpoints.db
SECRET_VAULT_DB_PATH=/vault/credentials.db
PROVIDER_EFFECTS_DB_PATH=/data/provider_effects.db

# ── Encryption keys (generate independently; keep stable across redeploys) ────
LANGGRAPH_AES_KEY=
SECRET_VAULT_KEY=

# ── Provider credentials (leave blank until you deploy with live providers) ───
PERPLEXITY_API_KEY=
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# First provider in the browser-decision chain (strict json_schema on gpt-oss).
# Without at least one working backend the action loop cannot resolve an
# ambiguous page and stops at a human gate instead of continuing autonomously.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=ops-owner
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
# Public run page used after a managed Composio OAuth flow. This must be the
# externally reachable HTTPS origin, not OPS_API_URL on the private network.
MANAGED_AUTH_CALLBACK_BASE_URL=https://your-domain.example
BROWSER_USE_API_KEY=
# Browser Use is dormant compatibility code during the Playwright rollout. Do
# not configure a key until that adapter has been separately requalified.
BROWSER_PROVIDER=playwright
BROWSER_USE_COMPATIBILITY_ENABLED=false
# Authenticated private RPC to the isolated Chromium service in compose.prod.
BROWSER_SERVICE_TOKEN=replace-with-random-browser-service-token
BROWSER_SERVICE_OWNER=production-owner
# View-only streaming is continuous; control is granted only while a run is in
# HITL. Keep one isolated display/session on the current VPS.
BROWSER_INTERACTIVE_HITL_ENABLED=true
PLAYWRIGHT_DISABLE_SANDBOX=true
BROWSER_SESSION_INACTIVITY_SECONDS=900
BROWSER_SESSION_MAX_AGE_SECONDS=3600
# Optional encrypted Playwright storage-state persistence; leave blank to disable.
BROWSER_STORAGE_STATE_KEY=

# ── You.com official documentation discovery ─────────────────────────────────
# You.com is a RESEARCH/RETRIEVAL provider only. It improves discovery of
# official login, signup, developer-portal and API-credential documentation
# ahead of Perplexity and the guarded HTTP fetcher. It NEVER operates a
# browser, never receives credentials/API keys/OTPs/cookies/vault values, and
# never changes a run's selected browser provider.
#
# Server-side API key used only for public official-document research. Every
# capability below ALSO requires the matching flag to be turned on: a key alone
# never spends credits (all three capabilities default to disabled).
YDC_API_KEY=

# Staged rollout — enable each stage DELIBERATELY after evaluating the previous.
# Stage 1: primary discovery of official login/signup/developer/API docs.
YOU_SEARCH_ENABLED=false
# Stage 2: fetch clean Markdown for selected, policy-approved official URLs.
YOU_CONTENTS_ENABLED=false
# Stage 3: expensive multi-step fallback; keep disabled until Search + Contents
# metrics are understood (see docs/APP_RECIPES.md).
YOU_RESEARCH_ENABLED=false

YOU_SEARCH_COUNT=5
YOU_SEARCH_TIMEOUT_SECONDS=20
YOU_CONTENTS_TIMEOUT_SECONDS=30
YOU_CONTENTS_MAX_AGE_SECONDS=86400
YOU_RESEARCH_TIMEOUT_SECONDS=60
YOU_MAX_SEARCH_CALLS_PER_ENRICHMENT=2
YOU_MAX_CONTENTS_PAGES_PER_ENRICHMENT=8
YOU_MAX_RESEARCH_CALLS_PER_ENRICHMENT=1

# Persistent research cache (SQLite) shared by Search/Contents/Research so
# identical app research does not re-spend credits. Never stores secrets.
RESEARCH_CACHE_DB_PATH=/data/research_cache.db

# ── Outreach / live-action safety (keep disabled by default) ──────────────────
# Optional vault reference that redirects vendor outreach to a controlled inbox.
OUTREACH_RECIPIENT_OVERRIDE=
# Live Gmail sending stays OFF unless explicitly authorized.
ALLOW_LIVE_VENDOR_EMAIL=false
# Playwright stays fail-closed unless production opts in and the isolated browser
# service is healthy. Browser Use remains disabled regardless of a stray key.
ALLOW_LIVE_BROWSER=false
# Owner-only credential submission, autonomous-login injection, live-view, and
# raw-credential reveal are ALL gated by this flag. Set it to true to enable
# those operator actions (they remain loopback/owner-token gated); leave false
# to keep them disabled.
ALLOW_LOCAL_CREDENTIAL_SUBMISSION=false
# Live provider tests stay OFF in production.
RUN_LIVE_TESTS=0
