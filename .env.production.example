# Production environment template for the single-Droplet deployment.
#
# Copy this file to .env.production and fill in the blank values:
#     cp .env.production.example .env.production
#
# WARNINGS
#   - NEVER commit .env.production. Only this .example template is tracked.
#   - NEVER put provider keys in NEXT_PUBLIC_ variables. Nothing here is exposed
#     to the browser; the frontend reads OPS_API_URL only in server code.
#   - Generate each private storage key INDEPENDENTLY with a cryptographically
#     secure generator (see docs/OPERATIONS.md). Never reuse a key.
#   - Retain the SAME SECRET_VAULT_KEY across every redeployment. Changing it
#     without migration makes stored credential payloads unreadable.
#   - LANGGRAPH_AES_KEY is required by current recovery tooling for possible
#     legacy artifacts. Canonical run/effect SQLite state is not encrypted by it,
#     and production does not initialize the legacy checkpoint reader.

# ── Reverse proxy / TLS ───────────────────────────────────────────────────────
# Public hostname whose DNS A record points at the Droplet. Caddy issues HTTPS
# for this name automatically. For an IP-only development fallback use ":80"
# (plain HTTP, no certificate) — see deploy/Caddyfile.
#
# UNSET/left as the example: deploy-droplet.sh refuses the release outright
# ("DOMAIN is required for public TLS verification." / "DOMAIN still contains
# the example value."). It is also the site address in deploy/Caddyfile line 41,
# so a wrong value means Caddy serves a certificate for a name nobody resolves
# and every request reaches the wrong site block. The host part of
# MANAGED_AUTH_CALLBACK_BASE_URL must match it EXACTLY — the deploy gate
# compares them ("MANAGED_AUTH_CALLBACK_BASE_URL host must exactly match
# DOMAIN.").
DOMAIN=your-domain.example
# Optional: email used only for certificate expiry notices.
#
# UNSET: deploy/Caddyfile falls back to `{$ACME_EMAIL:admin@example.com}`, so
# TLS issuance still succeeds and nothing breaks at deploy time — you simply get
# no expiry warnings at a mailbox you own. Set it before the first renewal
# window if you want them.
ACME_EMAIL=
# Bound Docker json-file logs so a noisy provider/browser cannot fill the host.
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5
# Application log level for the api and browser-worker containers. Everything the
# code emits is written to stdout, so `docker compose logs` is the log store and
# the two settings above are its retention policy. INFO is what the code is
# written for. DEBUG is deliberately not reachable from this variable alone —
# debug records in the browser paths carry rendered page text, so it also needs
# OPS_ALLOW_DEBUG_LOGGING=true, and should be turned back off afterwards.
OPS_LOG_LEVEL=INFO
OPS_ALLOW_DEBUG_LOGGING=false

# ── Container resource ceilings (8 GiB / 4 vCPU host baseline) ───────────────
# Defaults total 7 GiB and 4 vCPU of container quotas, leaving about 1 GiB of
# memory for the host kernel and Docker. CPU values are ceilings, not reserved
# cores. Keep browser-worker largest because Chromium, Xvfb, VNC, and noVNC run
# there; reduce PLAYWRIGHT_MAX_SESSIONS before raising these host-wide totals.
API_MEM_LIMIT=1536m
API_CPUS=1.0
BROWSER_MEM_LIMIT=4g
BROWSER_CPUS=2.0
WEB_MEM_LIMIT=1g
WEB_CPUS=0.75
CADDY_MEM_LIMIT=512m
CADDY_CPUS=0.25

# ── Frontend (server-only) ────────────────────────────────────────────────────
# Internal address of the API on the private Docker network. Read only by
# Next.js server code. Do not point this at a public URL.
OPS_API_URL=http://api:8000
# Shared internal API token. This is passed only to the API and web containers;
# it must never be exposed as NEXT_PUBLIC_*.
OPS_INTERNAL_API_TOKEN=replace-with-random-internal-token
# Server-only demo banner toggle.
OPS_DEMO_MODE=false
# Application login protects the UI and server actions with a signed HTTP-only
# session. Use a unique password and a random 32-byte-or-longer session secret.
# None of these values may use a NEXT_PUBLIC_ prefix.
OPS_AUTH_USERNAME=ops-admin
OPS_AUTH_PASSWORD=replace-with-strong-application-password # pragma: allowlist secret
OPS_AUTH_SESSION_SECRET=replace-with-random-32-byte-session-secret
# Outer Next.js request budget. Keep this above the API browser-service client
# timeout so structured backend failures reach the progress UI.
OPS_RUN_ACTION_TIMEOUT_MS=330000

# ── API: cross-origin + docs ──────────────────────────────────────────────────
# Browser origin(s) allowed to call the API directly. In this topology the
# browser talks to Next.js, not the API, so this should just match your site.
#
# UNSET: api/app.py::_cors_origins supplies the CORSMiddleware allow-list, and
# an empty list means the API answers no cross-origin preflight at all. In the
# normal Caddy → web → api path nothing notices, because Next.js server code
# makes those calls and browsers never send an Origin the API must approve. It
# starts mattering the moment anything talks to the API directly (a debugging
# fetch from the site origin, a future direct-to-API surface): those requests
# fail CORS with no server-side error to read. Keep it equal to
# https://${DOMAIN} — a value pointing anywhere else is worse than blank.
OPS_CORS_ORIGINS=https://your-domain.example
# Keep API docs disabled in production.
OPS_ENABLE_API_DOCS=false
# Production Compose enables delayed maintenance. Startup itself performs no
# provider call; the interruptible grace window lets a rejected candidate stop
# before Gmail polling or browser reconciliation begins.
OPS_STARTUP_AUTOMATION_ENABLED=true
OPS_AUTOMATION_START_DELAY_SECONDS=60
EMAIL_POLL_INTERVAL_SECONDS=45
EMAIL_POLL_MAX_RUNS_PER_CYCLE=25
# Bounds for ONE inbound-reply classification, spent inside the email-poller
# thread that walks up to EMAIL_POLL_MAX_RUNS_PER_CYCLE runs. TOTAL is the cap
# on the whole provider chain; before it existed the worst case was three
# sequential 45s transport timeouts plus a backend that looped its own model
# chain. PROVIDER matches the httpx transport timeout on purpose, so the
# wall-clock guard only fires for a socket that is genuinely hung.
EMAIL_MODEL_TOTAL_SECONDS=120
EMAIL_MODEL_PROVIDER_SECONDS=45
EMAIL_MODEL_MAX_PROVIDERS=5

# ── API: persistent database paths (under the /data volume) ───────────────────
OPS_DB_PATH=/data/ops.db
CHECKPOINT_DB_PATH=/data/checkpoints.db
SECRET_VAULT_DB_PATH=/vault/credentials.db
PROVIDER_EFFECTS_DB_PATH=/data/provider_effects.db

# ── Private storage keys (see boundary notes above) ───────────────────────────
LANGGRAPH_AES_KEY=
SECRET_VAULT_KEY=

# ── Provider credentials (leave blank until you deploy with live providers) ───
PERPLEXITY_API_KEY=
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Second provider in the browser-decision chain (strict json_schema on gpt-oss).
# Without at least one working backend the action loop cannot resolve an
# ambiguous page and stops at a human gate instead of continuing autonomously.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# FIRST provider for every model task: the browser-decision chain, the outreach
# email loop, and the operational-research extractor all try Mercury before
# anything else, so this one key covers the whole deployment. Falls back to Groq
# and the rest when unset.
#
# The reasoning dial accepts instant, low, medium, or high. "high" is the top of
# that range — there is no setting above it — and is the default: misreading an
# ambiguous page costs a whole run, while deliberating over one costs seconds.
# Set this to low or instant only if you would rather have the latency back.
MERCURY_API_KEY=
MERCURY_MODEL=mercury-2
MERCURY_REASONING_EFFORT=high
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=ops-owner
# Optional when Gmail lives in a different Composio project. When blank, Gmail
# uses COMPOSIO_API_KEY for backward compatibility.
COMPOSIO_GMAIL_API_KEY=
# External user that owns the signup inbox connection. When blank, this falls
# back to COMPOSIO_USER_ID for single-project deployments.
COMPOSIO_GMAIL_USER_ID=
# Signup/login inbox identity. The connected-account ID authorizes Gmail reads;
# the exact address binds an OTP/magic link to the run's intended recipient.
# These are independent of OUTREACH_RECIPIENT_OVERRIDE below. They are required
# only when create-account or email-verification flows are enabled.
COMPOSIO_GMAIL_SIGNUP_CONNECTED_ACCOUNT_ID=
GMAIL_SIGNUP_ADDRESS=
# The one identity provider the signup driver may hand registration to when a
# vendor refuses the email path for GMAIL_SIGNUP_ADDRESS -- Apify rejects every
# @gmail.com address and offers only "Continue with Google". The run then
# completes as whichever account that provider signs in, so the vault holds a
# credential for that account. Blank restores stopping for a human instead.
# One of: google, github, gitlab, microsoft, apple.
SIGNUP_IDENTITY_HANDOFF_PROVIDER=google
# Deprecated compatibility fallback for deployments not yet split by purpose.
# Prefer COMPOSIO_GMAIL_SIGNUP_CONNECTED_ACCOUNT_ID for all new deployments.
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
GMAIL_VERIFICATION_MAX_AGE_SECONDS=900
GMAIL_SIGNUP_PREFLIGHT_TIMEOUT_SECONDS=10
GMAIL_VERIFICATION_MAX_ATTEMPTS=6
GMAIL_VERIFICATION_POLL_SECONDS=5
GMAIL_VERIFICATION_REQUIRE_BINDING=true
GMAIL_VERIFICATION_REQUIRE_AUTHENTICATED_SENDER=true
# Public run page used after a managed Composio OAuth flow. This must be the
# externally reachable HTTPS origin on the exact DOMAIN host, not OPS_API_URL
# on the private network. Production has no HTTP or localhost exception.
#
# UNSET or still a placeholder: two separate failures.
#   1. deploy-droplet.sh rejects the release before anything starts
#      ("MANAGED_AUTH_CALLBACK_BASE_URL is required." / "…contains an example
#      placeholder." / "…host must exactly match DOMAIN.").
#   2. At runtime, ops/providers/composio_managed_auth.py::
#      managed_auth_configuration_is_valid returns False, so managed OAuth is
#      reported unconfigured on the health endpoint and every app whose only
#      path is managed auth stops at a human gate instead of connecting.
# Must be https, the standard port, no path/query/fragment, no credentials.
MANAGED_AUTH_CALLBACK_BASE_URL=https://your-domain.example
# The self-hosted Playwright harness is the only browser backend; "playwright" is
# the only accepted value. The variable is still read so an existing host file
# does not have to change.
BROWSER_PROVIDER=playwright
# Authenticated private RPC to the isolated Chromium service in compose.prod.
BROWSER_SERVICE_TOKEN=replace-with-random-browser-service-token
# Stable API-only master used to derive a different browser-session capability for
# every run. Generate independently, keep it unchanged across API restarts, and
# rotate it only after draining sessions up to BROWSER_SESSION_MAX_AGE_SECONDS.
BROWSER_SESSION_CAPABILITY_KEY=replace-with-random-browser-session-capability-key
# Independent capability token shared only by API and browser-worker. Never
# reuse OPS_INTERNAL_API_TOKEN or BROWSER_SERVICE_TOKEN here.
BROWSER_SECRET_BROKER_TOKEN=replace-with-random-browser-secret-broker-token
BROWSER_SERVICE_OWNER=production-owner
# View-only streaming is continuous; control is granted only while a run is in
# HITL. Each session owns a private display. Start with two on a suitably sized
# host; use one on a small Droplet, or increase gradually up to the hard limit 10.
BROWSER_INTERACTIVE_HITL_ENABLED=true
PLAYWRIGHT_MAX_SESSIONS=2
BROWSER_SHM_SIZE=2gb
BROWSER_PIDS_LIMIT=768
BROWSER_SCREEN_GEOMETRY=1440x900x24
# Keep Chromium's sandbox enabled. Set true only for a documented host
# incompatibility after accepting the reduced isolation.
PLAYWRIGHT_DISABLE_SANDBOX=false
BROWSER_SESSION_INACTIVITY_SECONDS=900
BROWSER_SESSION_MAX_AGE_SECONDS=3600
BROWSER_SESSION_DRAIN_SECONDS=30
# Timeout contract: worker 300s < API client 315s < web 330s < Caddy 345s.
# The worker's own budget is now derived rather than guessed: 45s navigation +
# the action loop's share of BROWSER_SERVICE_CLIENT_TIMEOUT_SECONDS + 20s to
# serialize and reply = 295s, which is why 300 above still holds. Settings
# refuses a combination where that sum reaches the client timeout, because a
# loop that spent its whole budget used to be aborted client-side with no step
# named and then fenced by the staleness sweep one second later.
BROWSER_OPERATION_TIMEOUT_SECONDS=300
BROWSER_SERVICE_CLIENT_TIMEOUT_SECONDS=315
# How many observe/decide/act/verify steps one browser operation may take. The
# step bound, distinct from the wall clock above.
BROWSER_AGENT_MAX_STEPS=20
# Bounds for ONE "what do I click next" decision inside that loop. TOTAL is the
# whole provider chain, PROVIDER one attempt's slice, MAX_PROVIDERS how many of
# the configured providers may be tried. Settings floors
# ONBOARDING_STEP_DECIDE_TIMEOUT_SECONDS by TOTAL, so the step deadline can no
# longer kill the chain it is meant to contain.
ONBOARDING_ACTION_DECISION_TOTAL_SECONDS=60
ONBOARDING_ACTION_DECISION_PROVIDER_SECONDS=25
ONBOARDING_ACTION_MAX_PROVIDERS=5
BROWSER_SECRET_BROKER_TIMEOUT_SECONDS=10
# Optional encrypted Playwright storage-state persistence; leave blank to disable.
#
# FORMAT: a Fernet key — 32 random bytes, urlsafe-base64 encoded, 44 characters
# ending in "=". ops/browser/storage_state.py feeds this straight to
# cryptography.fernet.Fernet, so any other shape fails with
# storage_state_key_invalid. Generate one with:
#   ./.venv/bin/python -c "from cryptography.fernet import Fernet; \
#       print(Fernet.generate_key().decode())"
#
# UNSET (blank): EncryptedStorageStateStore.enabled is False, so authenticated
# Chromium state is never written — nothing is stored in the clear, which is the
# safe default. The cost is that every run logs in from scratch: a vendor that
# only mails an OTP per new session gets asked for one every single run, and any
# app whose recipe expects a warm session re-walks the whole login each time.
#
# ONLY browser-worker may hold it. The deploy gate refuses a release where the
# API container can see it ("BROWSER_STORAGE_STATE_KEY must not be available to
# the API container"); compose.prod.yaml blanks it there on purpose.
BROWSER_STORAGE_STATE_KEY=

# ── Business identity typed into vendor signup forms ─────────────────────────
# Read by ops/playwright/actions.py, which runs INSIDE browser-worker. These are
# not secrets. Unset means the corresponding form field is left blank and a
# signup that asks for it stops at a human gate on a page the run had everything
# else it needed to finish. COMPANY_WORK_EMAIL_REF stays API-side only.
COMPANY_LEGAL_NAME=
COMPANY_WEBSITE=
COMPANY_USE_CASE=
COMPANY_EXPECTED_VOLUME=

# ── You.com official documentation discovery ─────────────────────────────────
# You.com is a RESEARCH/RETRIEVAL provider only. It improves discovery of
# official login, signup, developer-portal and API-credential documentation
# ahead of Perplexity and the guarded HTTP fetcher. It NEVER operates a
# browser, never receives credentials/API keys/OTPs/cookies/vault values, and
# never changes a run's selected browser provider.
#
# Server-side API key used only for public official-document research. Every
# capability below ALSO requires the matching flag to be turned on: a key alone
# never spends credits (all three capabilities default to disabled).
YDC_API_KEY=

# Staged rollout — enable each stage DELIBERATELY after evaluating the previous.
# Stage 1: primary discovery of official login/signup/developer/API docs.
YOU_SEARCH_ENABLED=false
# Stage 2: fetch clean Markdown for selected, policy-approved official URLs.
YOU_CONTENTS_ENABLED=false
# Stage 3: expensive multi-step fallback; keep disabled until Search + Contents
# metrics are understood (see docs/APP_RECIPES.md).
YOU_RESEARCH_ENABLED=false

YOU_SEARCH_COUNT=5
YOU_SEARCH_TIMEOUT_SECONDS=20
YOU_CONTENTS_TIMEOUT_SECONDS=30
YOU_CONTENTS_MAX_AGE_SECONDS=86400
YOU_RESEARCH_TIMEOUT_SECONDS=60
YOU_MAX_SEARCH_CALLS_PER_ENRICHMENT=2
YOU_MAX_CONTENTS_PAGES_PER_ENRICHMENT=8
YOU_MAX_RESEARCH_CALLS_PER_ENRICHMENT=1

# Persistent research cache (SQLite) shared by Search/Contents/Research so
# identical app research does not re-spend credits. Never stores secrets.
RESEARCH_CACHE_DB_PATH=/data/research_cache.db

# ── Outreach / live-action safety (keep disabled by default) ──────────────────
# Deployment-wide mailbox that redirects vendor outreach to one controlled sink.
# It is never accepted from an individual run request.
OUTREACH_RECIPIENT_OVERRIDE=
# Live Gmail sending stays OFF unless explicitly authorized.
#
# FALSE: ops/gmail/worker.py::_actual_recipient raises ConfigurationRequiredError
# (reason_code controlled_recipient_required) for every outbound vendor mail, so
# any run that needs to email a vendor stops there. The ONE exception is
# OUTREACH_RECIPIENT_OVERRIDE above: with a sink address set, mail is sent to
# the sink and this flag is never consulted. So set the override for a rehearsal
# and set this to true only when real vendors should receive real mail.
# COMPANION REQUIRED: COMPOSIO_GMAIL_API_KEY (or COMPOSIO_API_KEY) and a Gmail
# connected-account id, or there is no mailbox to send from.
ALLOW_LIVE_VENDOR_EMAIL=false
# Playwright stays fail-closed unless production opts in and the isolated browser
# service is healthy. Browser Use remains disabled regardless of a stray key.
#
# FALSE: this is the master switch for the whole autonomous browser.
# ops/playwright/worker.py::_require_configuration raises
# ConfigurationRequiredError (reason_code live_browser_opt_in_required) before a
# single page is opened, and ops/browser/readiness.py::browser_configuration_state
# returns False, so /api/system/health reports the playwright provider as not
# configured and no run ever reaches a live page.
# COMPANION REQUIRED — the flag alone is NOT "configured"; readiness also needs
# all three of: BROWSER_SERVICE_TOKEN, BROWSER_SESSION_CAPABILITY_KEY, and a
# reachable BROWSER_SERVICE_URL (Compose pins it to http://browser-worker:8081).
# Plus at least one inference key (MERCURY_API_KEY first, then GROQ_API_KEY):
# with none of them the action loop has no backend and every ambiguous page
# becomes a human gate.
ALLOW_LIVE_BROWSER=false
# Owner-only credential submission, autonomous-login injection, live-view, and
# raw-credential reveal are ALL gated by this flag. Set it to true to enable
# those operator actions (they remain loopback/owner-token gated); leave false
# to keep them disabled.
#
# FALSE: api/browser_ui.py computes can_submit_otp, can_submit_login and
# can_submit_credential as False no matter what the run's state is, so the
# operator UI renders a paused run with no way to act on it — the OTP box, the
# login form and the reveal button are simply absent, and a run parked at a
# credential gate can only be abandoned. It does NOT disable the browser itself;
# ALLOW_LIVE_BROWSER does that.
# COMPANION REQUIRED: BROWSER_INTERACTIVE_HITL_ENABLED=true for the interactive
# (not screenshot-only) live view, and BROWSER_SERVICE_OWNER matching across the
# api, browser-worker and caddy containers — the deploy gate enforces that match.
ALLOW_LOCAL_CREDENTIAL_SUBMISSION=false
# ---------------------------------------------------------------------------
# Provider profile research (the recipe-free onboarding path).
#
# These are NOT the YOU_* flags above. Those enrich a reviewed catalog entry
# from a host list that entry already carries. These build a provider profile
# from nothing but a provider NAME, which is the only input an app with no
# reviewed recipe has — and without a profile, driver.py raises PhaseNotDrivable
# before the browser is asked to do anything, because the confinement allow-list
# IS profile.allowed_hosts().
#
# With every flag below false, research_adapters() raises
# research_adapters_not_configured and no recipe-free app is drivable at all.
#
# Primary discovery: works from the provider name alone, so this is the one that
# makes an unknown app drivable. COMPANION REQUIRED — PERPLEXITY_API_KEY, or the
# flag raises at startup rather than degrading quietly.
ONBOARDING_RESEARCH_PERPLEXITY_ENABLED=false
# Harvests the provider's own homepage for signup/login/developer anchors
# through the hardened fetcher. Keyless and spends nothing, but it needs a seed
# URL, so it supplements the discovery adapter above rather than replacing it.
# Off by default because it is the first adapter that makes a stock deployment
# issue outbound HTTP to a host chosen from data.
ONBOARDING_RESEARCH_HOMEPAGE_ANCHORS_ENABLED=false
# ---------------------------------------------------------------------------
# Standing authorization to create accounts (unattended signup).
#
# This is not a feature flag. It is the record of a decision a person made, and
# it is the ONLY thing that lets a run create an account on a provider without
# stopping to ask. A run whose app is not covered here still pauses at
# awaiting_admission and waits for an operator, exactly as every run did before
# 2026-08-09.
#
# What the agent does under this authorization: fills the provider's signup
# form with the deployment's identity, ACCEPTS THAT PROVIDER'S TERMS OF SERVICE
# in the owner's name, and completes email verification — with no per-run human
# record. What survives is the durable admission row, which names
# ONBOARDING_SIGNUP_AUTHORIZED_BY, stamps ONBOARDING_SIGNUP_AUTHORIZED_AT, and
# reads decided_by=standing_authorization so an audit can always tell these
# accounts from ones an operator approved by name.
#
# EMPTY (the default) is the fail-closed state: no app is authorized.
# A comma-separated list of catalog slugs authorizes exactly those apps.
# The single token * authorizes the whole reviewed catalog; it is expanded to
# concrete slugs at read time, so no decision row ever records a wildcard.
# A slug that is not in the reviewed catalog is ignored, listed or not.
#
# BOTH companions are REQUIRED whenever the list is non-empty — the settings
# model refuses to start otherwise, because an authorization with nobody's name
# on it is the untraceable signup this design exists to prevent.
# AUTHORIZED_BY is a single-line identifier (the owner's id or email).
# AUTHORIZED_AT is an ISO-8601 timestamp: when the authorization was given, NOT
# when the run reached the page.
#
# Granting and revoking are both deploys. That is deliberate: an authorization
# to enter vendor agreements should not be something the running control plane
# can grant itself with an API call.
ONBOARDING_SIGNUP_AUTHORIZED_APPS=
ONBOARDING_SIGNUP_AUTHORIZED_BY=
ONBOARDING_SIGNUP_AUTHORIZED_AT=
# ---------------------------------------------------------------------------
# Live provider tests stay OFF in production.
RUN_LIVE_TESTS=0
